{
  "name": "x509-trust",
  "version": "0.3.0",
  "description": "X.509 certificate chain and revocation validation for Node.js",
  "type": "module",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/swantrace/x509-trust.git"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "engines": {
    "node": ">=24"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "native/index.node",
    "native/index.d.ts"
  ],
  "keywords": [
    "x509",
    "pki",
    "certificate",
    "crl",
    "ocsp"
  ],
  "scripts": {
    "build": "npm run build:native && npm run build:ts",
    "build:release": "npm run build:native:release && npm run build:ts",
    "build:ts": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "format": "biome check --write .",
    "format:check": "biome check .",
    "build:native": "napi build --manifest-path native/Cargo.toml --output-dir native && biome format --write native/index.d.ts",
    "build:native:release": "napi build --manifest-path native/Cargo.toml --output-dir native --release && biome format --write native/index.d.ts",
    "test:native": "npm run build:native && node scripts/test-native.mjs",
    "pretest": "npm run build:native",
    "test": "node --test test/*.test.ts",
    "prepare": "husky && npm run build:release",
    "prepack": "npm run build:release"
  },
  "lint-staged": {
    "*.{js,ts,json,jsonc}": "biome check --write --no-errors-on-unmatched"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@napi-rs/cli": "^3.5.0",
    "@types/node": "^24.19.2",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "asn1js": "^4.0.0",
    "pkijs": "^4.0.0"
  }
}
