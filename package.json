{
  "name": "@sahara/x509-trust",
  "version": "0.1.0",
  "description": "X.509 certificate chain and revocation validation for Node.js",
  "type": "module",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=24"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "x509",
    "pki",
    "certificate",
    "crl",
    "ocsp"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "format": "biome check --write .",
    "format:check": "biome check .",
    "test": "node --test test/*.test.ts",
    "prepare": "husky && npm run build",
    "prepack": "npm run build"
  },
  "lint-staged": {
    "*.{js,ts,json,jsonc}": "biome check --write --no-errors-on-unmatched"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@types/node": "^24.19.2",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "asn1js": "^4.0.0",
    "pkijs": "^4.0.0"
  }
}
